source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins

# github-pages on Ruby 3.4+ needs these explicitly since they left the stdlib.
gem "csv"
gem "base64"
gem "bigdecimal"

group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# Windows / JRuby workarounds some Jekyll versions still expect.
platforms :windows, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

gem "wdm", "~> 0.1.1", :platforms => [:windows]

gem "http_parser.rb", "~> 0.6.0", :platforms => [:jruby]
