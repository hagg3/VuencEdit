# Published .gitignore for the public VuencEdit repo. Source: publish/vuencedit.gitignore
# in the private monorepo (publish.sh copies it over the root .gitignore). App-only:
# no private-repo or private-directory names.

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
/target/
**/src-tauri/target/
**/src-tauri/gen/
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.eden.bak
*.eden

# Jekyll site build output / gem vendoring
docs/_site/
docs/.jekyll-cache/
docs/.bundle/
docs/vendor/
